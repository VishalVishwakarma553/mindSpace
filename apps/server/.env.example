# HTTP
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Comma separated chrome-extension IDs allowed to call the API (empty = allow any unpacked extension in development)
EXTENSION_IDS=

# Data
MONGODB_URI=mongodb://127.0.0.1:27017/meetmind
STORAGE_DIR=./storage
MIN_FREE_DISK_MB=500
MAX_CHUNK_MB=60

# Security – use long random values in production
JWT_SECRET=change-me-to-a-long-random-string
WORKER_TOKEN=change-me-worker-token

# Local AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
