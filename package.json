{
  "name": "meetmind",
  "private": true,
  "version": "1.0.0",
  "description": "MeetMind – local-first AI meeting assistant",
  "workspaces": ["apps/server", "apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace apps/server & npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces",
    "seed": "npm run seed --workspace apps/server"
  },
  "engines": { "node": ">=20" }
}
